@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

' Chapter 8 solution. Each Item represents a physical copy with a unique number.

abstract class Item {
  - title : String
  - catalogueNumber : String
  - kind : ItemKind
  + getTitle() : String
  + getCatalogueNumber() : String
}

enum ItemKind {
  BOOK
  DVD
}

interface Borrowable {
  + getLoanPeriodDays() : int
  + isOnLoan() : boolean
  + borrow(member : Member, today : LocalDate) : Loan
  + returnItem() : void
}

class LoanableItem {
  - loanPeriodDays : int
  - activeLoan : Loan
  + getLoanPeriodDays() : int
  + isOnLoan() : boolean
  + borrow(member : Member, today : LocalDate) : Loan
  + returnItem() : void
}

class ReferenceItem

class Member {
  - memberNumber : String
  - lateFee : BigDecimal
  + waiveLateFee() : void
}

class Librarian {
  + addItem(library : Library, item : Item) : void
  + waiveLateFee(member : Member) : void
}

class Loan {
  - dueDate : LocalDate
}

class Hold {
  - placedAt : Instant
}

class Library {
  - catalogue : Map<String, Item>
  - members : Map<String, Member>
  - holds : List<Hold>
  + login(memberNumber : String) : Member
  + findItem(catalogueNumber : String) : Item
  + addItem(item : Item) : void
  + borrow(member : Member, item : LoanableItem, today : LocalDate) : Loan
  + placeHold(member : Member, catalogueNumber : String) : Hold
}

Item <|-- LoanableItem
Item <|-- ReferenceItem
Borrowable <|.. LoanableItem
Item --> ItemKind
Library "1" o-- "0..*" Item : catalogue
Library "1" o-- "0..*" Member : registered members
Library "1" *-- "0..*" Hold : remembers
LoanableItem "1" --> "0..1" Loan : active loan
Loan "0..*" --> "1" Member : borrower
Hold "0..*" --> "1" Member : requester
Hold "0..*" --> "1" LoanableItem : requested copy
Librarian ..> Library : adds items
Librarian ..> Member : waives fees

note right of LoanableItem
  BOOK: 21 days; DVD: 7 days.
  borrow rejects an existing active loan.
  isOnLoan iff activeLoan is present.
  returnItem clears the active loan.
end note

note bottom of Library
  addItem rejects duplicate catalogue numbers.
  placeHold requires a registered, signed-in member
  and a catalogue item that is loanable and on loan.
  A successful hold is appended to holds.
  login resolves the supplied member number;
  additional authentication rules are unspecified.
end note

@enduml
